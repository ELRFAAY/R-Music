<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_black_1000"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ringBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/ringTint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B3000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include layout="@layout/status_bar" />

    <!-- Vertical rhythm like the reference: ring high, title in the middle, controls low -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/titleGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.60" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/controlsGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.79" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/playerToolbar"
        style="@style/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_bar"
        app:navigationIcon="@drawable/ic_keyboard_arrow_down">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playingFromLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ring_playing_from"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/playingFrom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/md_white_1000"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Album name" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Progress ring (full circle) with the round cover inside -->
    <me.tankery.lib.circularseekbar.CircularSeekBar
        android:id="@+id/progressRing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="44dp"
        app:cs_circle_color="#33FFFFFF"
        app:cs_circle_progress_color="@color/md_white_1000"
        app:cs_circle_stroke_width="4dp"
        app:cs_end_angle="270"
        app:cs_move_outside_circle="true"
        app:cs_pointer_color="@color/md_white_1000"
        app:cs_pointer_halo_width="0dp"
        app:cs_pointer_stroke_width="14dp"
        app:cs_start_angle="270"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerToolbar"
        tools:progress="40" />

    <!-- Cover area: drag up/down = volume, double tap right/left = +/-10 s (CoverGestureLayout) -->
    <code.name.monkey.retromusic.views.CoverGestureLayout
        android:id="@+id/ringCoverArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toBottomOf="@id/progressRing"
        app:layout_constraintEnd_toEndOf="@id/progressRing"
        app:layout_constraintStart_toStartOf="@id/progressRing"
        app:layout_constraintTop_toTopOf="@id/progressRing">

        <code.name.monkey.retromusic.views.RetroShapeableImageView
            android:id="@+id/ringCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Circle"
            tools:srcCompat="@tools:sample/backgrounds/scenic[6]" />

        <code.name.monkey.retromusic.views.RetroShapeableImageView
            android:id="@+id/ringCoverNext"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Circle" />

        <code.name.monkey.retromusic.lyrics.CoverLrcView
            android:id="@+id/ringLyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:lrcLabel="@string/no_lyrics_found"
            app:lrcNormalTextSize="26sp"
            app:lrcPadding="20dp"
            app:lrcTextGravity="center"
            app:lrcTextSize="28sp"
            app:lrcTimelineColor="@color/transparent" />

        <code.name.monkey.retromusic.views.SeekSectorView
            android:id="@+id/seekSector"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Volume: white pill in the middle of the cover; white = level, grey = rest -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/volumeOverlay"
            android:layout_width="44dp"
            android:layout_height="170dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:cardBackgroundColor="#B3808080"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            tools:visibility="visible">

            <View
                android:id="@+id/volumeFill"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_gravity="bottom"
                android:background="@color/md_white_1000" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/md_white_1000"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/volumeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/md_black_1000"
                    android:textSize="13sp"
                    tools:text="71" />
            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_volume_up"
                app:tint="#808080" />
        </com.google.android.material.card.MaterialCardView>
    </code.name.monkey.retromusic.views.CoverGestureLayout>

    <!-- Row shown under the lyrics: fullscreen, search, edit, font size, close -->
    <LinearLayout
        android:id="@+id/lyricsTools"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressRing">

        <ImageView
            android:id="@+id/lyricsFullscreen"
            style="@style/RingLyricsToolIcon"
            android:contentDescription="@string/ring_lyrics_fullscreen"
            android:src="@drawable/ic_fullscreen" />

        <TextView
            android:id="@+id/lyricsSearch"
            style="@style/RingLyricsToolText"
            android:text="@string/ring_lyrics_search" />

        <TextView
            android:id="@+id/lyricsEdit"
            style="@style/RingLyricsToolText"
            android:text="@string/ring_lyrics_edit" />

        <TextView
            android:id="@+id/lyricsFont"
            style="@style/RingLyricsToolText"
            android:contentDescription="@string/ring_lyrics_font_size"
            android:text="A"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/lyricsClose"
            style="@style/RingLyricsToolIcon"
            android:contentDescription="@string/ring_lyrics_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/queueButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/roundSelector"
        android:contentDescription="@string/queue"
        android:src="@drawable/ic_queue_music"
        app:layout_constraintBottom_toBottomOf="@id/ringTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ringTitle"
        android:layout_marginStart="16dp"
        app:tint="@color/md_white_1000" />

    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/roundSelector"
        android:contentDescription="@string/action_add_to_favorites"
        android:src="@drawable/ic_favorite_border"
        app:layout_constraintBottom_toBottomOf="@id/ringTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ringTitle"
        app:tint="@color/md_white_1000" />

    <TextView
        android:id="@+id/ringTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/md_white_1000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/favoriteButton"
        app:layout_constraintStart_toEndOf="@id/queueButton"
        app:layout_constraintTop_toBottomOf="@id/titleGuide"
        tools:text="Song title" />

    <LinearLayout
        android:id="@+id/artistRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ringTitle">

        <TextView
            android:id="@+id/ringArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            tools:text="Artist" />

        <TextView
            android:id="@+id/lyricsChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_ring_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:text="@string/lyrics"
            android:textColor="@color/md_white_1000"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/controlsGuide">

        <ImageButton
            android:id="@+id/shuffleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/roundSelector"
            android:contentDescription="@string/action_shuffle_all"
            android:src="@drawable/ic_shuffle"
            app:tint="@color/md_white_1000" />

        <ImageButton
            android:id="@+id/previousButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="?attr/roundSelector"
            android:contentDescription="@string/action_previous"
            android:src="@drawable/ic_skip_previous"
            app:tint="@color/md_white_1000" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/playPauseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_play_arrow"
            app:backgroundTint="@color/md_white_1000"
            app:tint="@color/md_black_1000" />

        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/roundSelector"
            android:contentDescription="@string/action_next"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/md_white_1000" />

        <ImageButton
            android:id="@+id/repeatButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/roundSelector"
            android:contentDescription="@string/action_cycle_repeat"
            android:src="@drawable/ic_repeat"
            app:tint="@color/md_white_1000" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/shareButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/roundSelector"
        android:contentDescription="@string/action_share"
        android:src="@drawable/ic_share"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/md_white_1000" />

    <TextView
        android:id="@+id/artistCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/shareButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/shareButton"
        tools:text="6/155" />

    <ImageButton
        android:id="@+id/equalizerButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:background="?attr/roundSelector"
        android:contentDescription="@string/equalizer"
        android:src="@drawable/ic_equalizer"
        app:layout_constraintBottom_toBottomOf="@id/shareButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/shareButton"
        app:tint="@color/md_white_1000" />
</androidx.constraintlayout.widget.ConstraintLayout>
